datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? // <-- Ajoute cette ligne obligatoire pour NextAuth
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  lastSeen      DateTime?
  lastPath      String?

  accounts Account[]
  sessions Session[]

  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  carts          Cart[]
  activities        AdminActivity[]      @relation("AdminActor")
  notifications     AdminNotification[]
  supportReplies    SupportMessage[]     @relation("SupportReplyAuthor")
  newsletterSent    NewsletterCampaign[] @relation("NewsletterCampaignSender")
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model League {
  id   String  @id @default(cuid())
  name String  @unique
  slug String  @unique
  logo String?

  clubs Club[]
}

model Club {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logo     String?
  leagueId String

  league   League    @relation(fields: [leagueId], references: [id])
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float
  images      String[]
  description String
  isNew       Boolean  @default(false)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  oldPrice    Float?
  sizes       String[] @default(["S", "M", "L", "XL", "XXL"])
  typeLabel   String   @default("Domicile")
  saison      String   @default("")
  clubId      String

  club       Club        @relation(fields: [clubId], references: [id])
  reviews    Review[]
  orderItems OrderItem[]
  favorites  Favorite[]
  createdAt  DateTime    @default(now())
}

model Order {
  id              String         @id @default(cuid())
  userId          String?
  guestEmail      String?
  total           Float
  status          OrderStatus    @default(PENDING)
  stripeId        String?
  paymentStatus   PaymentStatus  @default(PENDING)
  shippingStatus  ShippingStatus @default(PENDING)
  shippingAddress Json?
  trackingNumber  String?
  createdAt       DateTime       @default(now())

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  size        String
  price       Float

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?  @unique
  items     Json
  total     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model AdminActivity {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AdminActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AdminNotification {
  id        String    @id @default(cuid())
  userId    String?
  title     String
  body      String?
  type      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
}

model SupportTicket {
  id           String              @id @default(cuid())
  visitorToken String?             @unique
  name         String
  email        String
  subject      String
  status       SupportTicketStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  messages     SupportMessage[]

  @@index([status, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String?
  body      String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation("SupportReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

/// Journal des campagnes promo envoyées depuis l'admin (voir /admin/newsletter).
model NewsletterCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String   @db.Text
  recipients Int
  sentById   String?
  createdAt  DateTime @default(now())

  sentBy User? @relation("NewsletterCampaignSender", fields: [sentById], references: [id], onDelete: SetNull)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

/// Mise en avant manuelle d'un maillot du catalogue (fichiers) depuis l'admin.
/// `productId` est l'identifiant du Maillot (ex: "ligue-1-psg-domicile-2627"),
/// pas une relation vers Product : le catalogue vendu vient des fichiers du
/// site (voir src/lib/products.ts), cette table ne fait que surcharger le
/// calcul automatique des sections "À la une / Tendances / Nouveautés / Promos".
model ProductHighlight {
  productId String        @id
  section   ProductSection?
  hidden    Boolean       @default(false)
  updatedAt DateTime      @updatedAt
}

enum ProductSection {
  vedette
  tendance
  nouveau
  promo
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
